# Potyro — potyro.app (the app) and the names that forward to it. docs/16.
# Caddy gets and renews every name's certificate by itself (Let's Encrypt).
#
# This is /etc/caddy/Caddyfile on the server (Caddy 2) as it ran on 2026-11-01, with the changes
# the server is being given now: the `/ai/*` route streams and waits 310 s (docs/16 "AI for apps"),
# and the shell's block serves `/privacy` and `/terms` as their pages, not cached (#117).
# After an edit: `caddy validate --config /etc/caddy/Caddyfile`, then `sudo systemctl reload caddy`.
# Nothing secret is in it.
{
	email ops@potyro.com
}

potyro.app {
	encode zstd gzip

	header {
		# The shell embeds no frame that fetches (#272, docs/22 §3.2): stops a shared app's
		# sandboxed frame navigating itself to a URL. index.html carries the same as a <meta>.
		Content-Security-Policy "frame-src 'none'"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# The CRDT relay (a websocket), through its gate (4206, packages/sync-gate), which holds each
	# address to its limits and passes the rest on to jazz-run (4201). The prefix is taken off.
	# Never straight to 4201: the relay itself takes anything from anyone (docs/16).
	handle_path /sync* {
		reverse_proxy 127.0.0.1:4206
	}

	# Rooms for multiplayer apps (docs/26). The relay's own routes start with /rooms/.
	handle /rooms/* {
		reverse_proxy 127.0.0.1:4205
	}

	# Demo links (docs/24): the link's page, its preview picture, and the share API.
	@share path_regexp share ^/s/[A-Za-z0-9_-]{22}(/preview\.(jpg|png))?/?$
	handle @share {
		reverse_proxy 127.0.0.1:4203
	}
	handle /share-api/* {
		reverse_proxy 127.0.0.1:4203
	}

	# The free AI allowance for apps (docs/23). The prefix is taken off: the relay serves /health,
	# /complete, /v1/chat/completions and /count. A chat answer is a stream: `flush_interval -1`
	# sends each piece on as it comes, and the timeouts are over the relay's own 300 s, so nothing
	# here gives up before it does.
	handle_path /ai/* {
		reverse_proxy 127.0.0.1:4204 {
			flush_interval -1
			transport http {
				response_header_timeout 310s
				read_timeout 310s
			}
		}
	}

	# Requests to the Potyro team (#263): the relay files them as GitHub issues.
	handle_path /requests/* {
		reverse_proxy 127.0.0.1:4202
	}

	# The app itself: every path that is not a file is the shell.
	#
	# `{path}.html` and `{path}index.html` are for the privacy page and the terms (#117,
	# packages/legal): a build that has them carries privacy.html, privacy/index.html and the same
	# for terms, and `/privacy` and `/privacy/` must be that page, not the app. `{path}` alone finds
	# neither: try_files matches a path without a trailing slash only against files, and `privacy`
	# is a directory, so both fell through to index.html (checked with Caddy 2.11.7). The build has
	# no other .html file but index.html, so nothing else changes.
	handle {
		root * /srv/potyro/site
		# /assets/* and the legal pages' own files (/legal/*) carry a hash of their bytes in their names.
		@assets path /assets/* /legal/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@fresh path / /index.html /sw.js /privacy* /terms*
		header @fresh Cache-Control "no-cache"
		# The icons, the manifest, robots.txt and the sitemap: unversioned names, so a day and no longer.
		@icons path /favicon.svg /favicon.ico /apple-touch-icon.png /icon-*.png /manifest.webmanifest /robots.txt /sitemap.xml
		header @icons Cache-Control "public, max-age=86400"
		try_files {path} {path}.html {path}index.html /index.html
		# The deploy's build leaves a brotli and a gzip copy beside each text file (#48,
		# packages/shell/precompress.ts). Sent as they are to a browser that accepts them: smaller than
		# what `encode` makes per request, and no work per request. A file with no copy is still
		# compressed by `encode` above.
		file_server {
			precompressed br gzip
		}
	}
}

# potyro.com: the site (#8, docs/16) — the home at /, the gallery at /apps/, the legal pages — a static
# folder with nothing from anyone else: its own fonts, pictures and recordings (media-src).
(site_headers) {
	header {
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self'; base-uri 'none'; form-action https://potyro.app; frame-ancestors 'none'"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

# One address for the site: www answers with a redirect, never with a second copy of every page.
www.potyro.com {
	redir https://potyro.com{uri} 301
}

potyro.com {
	root * /srv/potyro.com
	encode zstd gzip
	file_server

	# The gallery used to say it works under /gallery/; the site's apps page is /apps/.
	redir /gallery /apps/ 301
	redir /gallery/* /apps/ 301
	redir /index.html / 301

	# The site's own visit count (#10): its pages post {"event":"visit"} to /count on this same name,
	# so the policy above stays `connect-src 'self'`, and the AI relay counts it as one number a month
	# (docs/16 "AI for apps", Counts). Only the POST: the numbers are read at potyro.app/ai/count.
	@count {
		method POST
		path /count
	}
	reverse_proxy @count 127.0.0.1:4204

	# The gallery's fediverse account, @apps@potyro.com (docs/33): who it is (webfinger) and its
	# ActivityPub addresses, all under /fedi/. Other servers ask these, and POST follows to
	# /fedi/inbox; a person's browser is sent on to /apps/. Nothing a page of the site loads.
	@fedi path /.well-known/webfinger /fedi/*
	reverse_proxy @fedi 127.0.0.1:4207

	import site_headers
	# An address that is not a page: the site's own "this page does not exist", with the 404 status
	# and the same headers as every other page (an error is answered outside the block above).
	handle_errors {
		@missing expression {err.status_code} == 404
		handle @missing {
			import site_headers
			rewrite * /404.html
			file_server
		}
	}
	# Every page (the home, /apps/, the docs, the Learn-more pages, the privacy page and the terms):
	# kept, and asked about each time, so an upload shows at once and an unchanged page costs a 304.
	@page path / */ *.html
	header @page Cache-Control "no-cache"
	# Stylesheets and scripts carry ?v=<hash> in the pages, so a day's cache never serves a stale one.
	@assets path /gallery.css /gallery.js /site.css /site.js /text.css /text.js /tokens.css /hours.css /fonts/* /logo/* /shots/* /screens/* /media/* /favicon.svg /docs/*/diagrams.css /how/*/diagrams.css /developers/diagrams.css
	header @assets Cache-Control "public, max-age=86400"
	# robots.txt and the sitemap: a day too.
	@crawl path /robots.txt /sitemap.xml
	header @crawl Cache-Control "public, max-age=86400"
	# A file that cannot change under its address: a picture, a recording, a font or a logo a page
	# names with ?v=<a hash of its bytes> (site/build.mjs), and the legal pages' files, which carry
	# the hash in their names. A year. These two come after @assets: the last one that matches wins.
	@stamped {
		path /fonts/* /logo/* /shots/* /screens/* /media/*
		query v=*
	}
	header @stamped Cache-Control "public, max-age=31536000, immutable"
	@named path /legal/*
	header @named Cache-Control "public, max-age=31536000, immutable"

	# No access log: a gallery that keeps no record of you, on the server too.
	log {
		output discard
	}
}

# Until there is more to say there, the other names forward to the app.
potyro.org, www.potyro.org, www.potyro.app {
	redir https://potyro.app{uri} 302
}
