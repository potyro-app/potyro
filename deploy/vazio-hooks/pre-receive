#!/bin/sh
# vazio: ~/appinator.git/hooks/pre-receive — refuse, at once, a push that could never reach GitHub's
# main: anything but main, and a main that does not build on GitHub's. Everything else is accepted
# and judged by post-receive in the background (docs/16 §8).
set -e
while read -r old new ref; do
  if [ "$ref" != "refs/heads/main" ]; then
    echo "✘ push main here; branches go to GitHub (git push origin <branch>)"
    exit 1
  fi
  github=$(git ls-remote https://github.com/fuzue/appinator.git refs/heads/main | cut -f1)
  git fetch -q https://github.com/fuzue/appinator.git "$github" 2>/dev/null || true
  if ! git merge-base --is-ancestor "$github" "$new" 2>/dev/null; then
    echo "✘ $(echo "$new" | cut -c1-7) does not build on GitHub's main ($(echo "$github" | cut -c1-7)) — rebase onto origin/main and push again"
    exit 1
  fi
done
