# /etc/potyro/backup.env — read by deploy/backup.sh (root, mode 600). Every line is optional.

# Where the offsite copy goes: an rclone remote and a path in it, set up with `sudo rclone config`.
# Empty = no offsite copy, which is not a backup: the server's disk is one disk.
BACKUP_REMOTE=

# An age public key (age1...). When set, files are encrypted to it before they leave the server.
# Keep the matching private key somewhere that is NOT this server.
BACKUP_AGE_RECIPIENT=

# One line of text is POSTed here when a run fails (an ntfy topic, a webhook).
ALERT_URL=

# Called after every good run: a check that alerts when the nightly call did not come.
OK_URL=

# Defaults, change only with a reason.
# KEEP_DAILY=7
# KEEP_WEEKLY=4
# DISK_ALERT_PCT=85
# BACKUP_DIR=/var/backups/potyro
