# /etc/potyro/share-links.env — the share service (packages/share-links, docs/16 "Demo links and
# their previews"). Optional: without it the service runs. Root only:
# `sudo install -m 600 /dev/null /etc/potyro/share-links.env`.
# Names only here; the values are the owner's and never go in the repository.
# Leave out a line to get its default: docker reads `NAME=` as an empty value, not as unset.
# The service's other settings (HOST, PORT, POTYRO_SHARES_DIR, POTYRO_SHELL_INDEX,
# POTYRO_PUBLIC_ORIGIN) are not secret and are on its `docker run` line in deploy/containers.sh.

# The operator's token for taking a link down over HTTPS (DELETE /share-api/admin/shares/<id>).
# At least 32 characters (`openssl rand -base64 33`), or the service will not start. Unset: that
# route does not exist, and links are taken down on the server itself.
SHARE_ADMIN_TOKEN=

# The address a taken-down link's page says to write to: the terms' report address, the same as
# `abuse` in packages/shell/src/contacts.json. Unset, or a placeholder: contact@potyro.com.
SHARE_ABUSE_CONTACT=

# Optional limits, with their defaults (docs/16 "Limits per address"):
# SHARE_CREATE_PER_ADDRESS_DAY=   30
# SHARE_PAYLOAD_PER_ADDRESS_DAY=  300
# SHARE_PAGE_PER_ADDRESS_DAY=     2000
# SHARE_STORED_BYTES_DAY=         2000000000
# SHARE_MIN_FREE_BYTES=           1000000000
# TRUST_PROXY=                    caddy
