# /etc/potyro/requests.env — the request relay (packages/platform-requests, docs/16 "Requests to
# the Potyro team"). Root only: `sudo install -m 600 /dev/null /etc/potyro/requests.env`.
# Names only here; the values are the owner's and never go in the repository.
# Leave out a line to get its default: docker reads `NAME=` as an empty value, not as unset.

# Required. A fine-grained GitHub token: resource owner fuzue, only the repository below,
# repository permission Issues: Read and write, nothing else. Without it the relay will not start.
GITHUB_TOKEN=

# Where requests are filed as issues. Default fuzue/potyro.
POTYRO_REQUESTS_REPO=

# Inside the container: 0.0.0.0 (the container publishes it on 127.0.0.1 only), port 4202.
HOST=
PORT=
