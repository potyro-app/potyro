# /etc/potyro/ai.env — the free AI allowance (packages/ai-relay, docs/16 "AI for apps", docs/23).
# Root only: `sudo install -m 600 /dev/null /etc/potyro/ai.env`.
# Names only here; the values are the owner's and never go in the repository.
# Leave out a line to get its default: docker reads `NAME=` as an empty value, not as unset.
# Every variable and its default is also at the top of packages/ai-relay/src/server.ts.

# Required. A key for Potyro's own OpenRouter account, with a credit limit set there (that limit is
# the cap that holds even if the relay is wrong). Without it the relay will not start.
OPENROUTER_API_KEY=

# The whole service's spend a calendar month (UTC), both routes. Default 10.
AI_MONTHLY_CAP_USD=
# The same, a calendar day (UTC). Default AI_MONTHLY_CAP_USD / 8.
AI_DAY_USD=
# The month's spend and counts, so a restart keeps them. On the server: /data/ai-ledger.json.
AI_LEDGER=
# Comma-separated; the only models the chat route sends. Default deepseek/deepseek-v4-flash-0731.
AI_CHAT_MODELS=
# Where the plan is offered, once there is one (#120): /health carries it, and devices that asked are told. Empty: no plan.
AI_PLAN_URL=
# One device's chat allowance a month. Default 0.5.
AI_DEVICE_MONTH_USD=
# While this file exists, the chat route is off; no restart. On the server: /data/chat-off.
AI_CHAT_OFF_FILE=
# Whose X-Forwarded-For to believe: caddy (the last entry) or none. Default caddy.
TRUST_PROXY=
# Inside the container: 0.0.0.0 (the container publishes it on 127.0.0.1 only), port 4204.
HOST=
PORT=

# Optional, with their defaults:
# AI_MODEL=                  google/gemini-2.5-flash-lite — the model for /complete
# AI_MODEL_PRICES=           JSON {"<model>": {"input": 0.14, "output": 0.28}}, $ a million tokens
# AI_PER_DEVICE_DAY=         20 — /complete
# AI_PER_DEVICE_MONTH=       100 — /complete
# AI_PER_ADDRESS_DAY=        60 — /complete
# AI_MAX_IN_FLIGHT=          50 — requests out towards OpenRouter at once, both routes; the next gets 503 busy + Retry-After
# AI_ADDRESS_DAY_USD=        4 × AI_DEVICE_MONTH_USD, at most AI_ADDRESS_DAY_SHARE of AI_DAY_USD
# AI_ADDRESS_DAY_SHARE=      0.2 — the most of AI_DAY_USD one address (a home, a school, a carrier) may have a day
# AI_CHAT_RESERVE_USD=       0.02 — the least a chat request is held for while it is out
# AI_CHAT_MAX_TOKENS=        64000 — the clamp on max_tokens
# AI_CHAT_OFF=               1 turns the chat route off (needs a new container)
# AI_COUNT_PER_ADDRESS_DAY=  20 — POST /count from one address a day
# AI_CORS_ORIGINS=           https://localhost,capacitor://localhost — the native apps' origins
