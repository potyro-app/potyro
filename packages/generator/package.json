{
  "name": "@potyro/generator",
  "version": "0.0.0",
  "type": "module",
  "description": "AI generator eval harness (KA-06): score generated .app.ts sources (compile/validate/render) against a prompt corpus and a pluggable model backend. The measurable base for KA-05/KA-07.",
  "exports": {
    ".": "./src/index.ts",
    "./backends": "./src/backends.ts",
    "./agent": "./src/agent/index.ts",
    "./language": "./src/language.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "gen:reference": "vite-node scripts/build-reference.ts",
    "gen:corpus": "vite-node scripts/build-corpus.ts",
    "eval:cli": "vite-node scripts/run-cli-eval.ts --",
    "eval:openrouter": "vite-node scripts/run-cli-eval.ts -- --backend openrouter",
    "eval:modify": "vite-node scripts/run-modify-eval.ts --",
    "eval:modify:fixture": "vite-node scripts/fixture-review-sheet.ts --",
    "eval:modify:edits": "vite-node scripts/run-modify-edits-eval.ts --",
    "eval:ask": "vite-node scripts/run-ask-eval.ts --",
    "eval:translate": "vite-node scripts/run-translate-eval.ts --",
    "eval:translate:fixture": "vite-node scripts/run-translate-eval.ts -- --fixture",
    "i18n:app": "vite-node scripts/i18n-app.ts --"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@babel/parser": "^7.29.8",
    "@mlc-ai/web-llm": "^0.2.84",
    "@potyro/capabilities": "workspace:*",
    "@potyro/host": "workspace:*",
    "@potyro/i18n": "workspace:*",
    "@potyro/runtime": "workspace:*",
    "@potyro/store": "workspace:*",
    "esbuild": "^0.21.5",
    "magic-string": "^1.1.0",
    "potyro": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite-node": "^2.1.9"
  }
}
