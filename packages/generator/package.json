{
  "name": "@karta/generator",
  "version": "0.0.0",
  "type": "module",
  "description": "AI generator eval harness (KA-06): score generated .app.ts sources (compile/validate/render) against a prompt corpus and a pluggable model backend. The measurable base for KA-05/KA-07.",
  "exports": {
    ".": "./src/index.ts",
    "./backends": "./src/backends.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@karta/capabilities": "workspace:*",
    "@karta/host": "workspace:*",
    "@karta/runtime": "workspace:*",
    "@karta/store": "workspace:*",
    "@mlc-ai/web-llm": "^0.2.84",
    "esbuild": "^0.21.5",
    "karta": "workspace:*"
  }
}
