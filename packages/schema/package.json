{
  "name": "potyro",
  "version": "0.1.0",
  "author": "Edgar Zanella Alvarenga",
  "type": "module",
  "description": "Write Potyro apps: defineApp(), the ctx types, and `potyro pack` to make the package Add an app installs",
  "license": "Apache-2.0",
  "homepage": "https://potyro.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/potyro-app/potyro.git",
    "directory": "packages/schema"
  },
  "bugs": {
    "url": "https://github.com/potyro-app/potyro/issues"
  },
  "keywords": [
    "potyro",
    "app",
    "offline-first",
    "pwa"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "bin": {
    "potyro": "./bin/potyro.mjs"
  },
  "files": [
    "dist",
    "bin",
    "cli",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "build:dist": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm build:dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "prepublishOnly": "node ../../scripts/check-npm-packages.mjs --guard"
  },
  "dependencies": {
    "esbuild": "^0.24.2",
    "fflate": "^0.8.3",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "@types/react": ">=18"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "react": "^18.3.1"
  }
}
