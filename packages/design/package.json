{
  "name": "@potyro/design",
  "version": "0.0.0",
  "type": "module",
  "description": "Potyro's design system: the designer's tokens, the colour clock, the logo, the fonts and the guides (DESIGN.md, REDACAO.md). Depends on no Potyro package.",
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./tokens.css",
    "./logo/*": "./logo/*",
    "./fonts/*": "./fonts/*"
  },
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "gen:tokens": "node scripts/tokens.mjs",
    "gen:logo": "node scripts/split-logo.mjs source/potyro-logo.svg logo",
    "gen:lucide": "node scripts/lucide.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "lucide": "1.61.0",
    "lucide-react": "1.61.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
