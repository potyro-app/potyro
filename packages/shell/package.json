{
  "name": "@potyro/shell",
  "version": "0.0.0",
  "type": "module",
  "description": "Shell + PWA target (WP7): app switcher, nav, trust prompts, composition root, dev harness.",
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "dev": "vite",
    "dev:sandbox": "vite --mode sandbox",
    "dev:sandbox:quickjs": "vite --mode sandbox-quickjs",
    "build:web": "vite build"
  },
  "dependencies": {
    "@babel/parser": "^7.29.8",
    "@potyro/capabilities": "workspace:*",
    "@potyro/generator": "workspace:^",
    "@potyro/host": "workspace:*",
    "@lingui/core": "^5.9.5",
    "@lingui/react": "^5.9.5",
    "@potyro/i18n": "workspace:*",
    "@potyro/identity": "workspace:*",
    "@potyro/native": "workspace:*",
    "@potyro/platform-requests": "workspace:*",
    "@potyro/runtime": "workspace:*",
    "@potyro/store": "workspace:*",
    "@potyro/views": "workspace:*",
    "esbuild-wasm": "^0.28.1",
    "potyro": "workspace:*",
    "magic-string": "^1.1.0",
    "prismjs": "^1.30.0",
    "quickjs-emscripten": "^0.31.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/babel__parser": "^7.1.5",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.2",
    "happy-dom": "^20.11.1",
    "vite": "^5.4.11"
  }
}
