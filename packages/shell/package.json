{
  "name": "@karta/shell",
  "version": "0.0.0",
  "type": "module",
  "description": "Shell + PWA target (WP7): app switcher, nav, trust prompts, composition root, dev harness.",
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "dev": "vite",
    "dev:sandbox": "vite --mode sandbox",
    "build:web": "vite build"
  },
  "dependencies": {
    "@karta/capabilities": "workspace:*",
    "@karta/host": "workspace:*",
    "@karta/runtime": "workspace:*",
    "@karta/store": "workspace:*",
    "@karta/views": "workspace:*",
    "karta": "workspace:*",
    "quickjs-emscripten": "^0.31.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.0",
    "happy-dom": "^20.11.1",
    "vite": "^5.4.11"
  }
}
