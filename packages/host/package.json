  },
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@potyro/capabilities": "workspace:*",
    "@potyro/rooms": "workspace:*",
    "@potyro/store": "workspace:*",
    "intl-messageformat": "^10.7.18",
    "potyro": "workspace:*",
    "quickjs-emscripten": "^0.31.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.24.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
