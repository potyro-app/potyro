#. Asked before an app first uses voice input (ctx.caps.speech); {appName} is the app
#: ../shell/src/app-speech.ts
msgid "“{appName}” wants to listen to you through the microphone."
msgstr "«{appName}» vuole ascoltarti tramite il microfono."

#. Asked before a shared app first uses AI on a picture
#: ../shell/src/app-ai.ts
msgid "“{appName}” wants to send a photo to an AI service (OpenRouter) to read it."
msgstr "«{appName}» vuole inviare una foto a un servizio di IA (OpenRouter) per leggerla."

#. Asked before a shared app first uses AI on words
#: ../shell/src/app-ai.ts
msgid "“{appName}” wants to send some text to an AI service (OpenRouter)."
msgstr "«{appName}» vuole inviare un testo a un servizio di IA (OpenRouter)."

