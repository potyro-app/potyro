node_modules/
dist/
*.tsbuildinfo
.vite/
coverage/
.DS_Store
*.log

# Playwright e2e artifacts (issue #15)
test-results/
playwright-report/
/playwright/.cache/

# Local agent config (do not publish)
# Claude Code: the checked-in skills travel with the repo; everything else there is a device's own
.claude/*
!.claude/skills/

# Capacitor generated native projects (regenerate with: pnpm --filter @potyro/native cap:add:android)
packages/native/android/
packages/native/ios/

# Generator eval artifacts — generated apps + reports (regenerate with: pnpm --filter @potyro/generator eval:cli)
packages/generator/eval-out/

# local sync relay database
.potyro-relay.sqlite*
packages/generator/.potyro-eval-*/
# local CI results, per commit (scripts/ci-local.mjs)
.ci-local/

# devlens session recordings (the dev proxy writes them into the project it watches)
.devlens/
