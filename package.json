{
  "name": "appinator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.5.0",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck && pnpm typecheck:spikes",
    "lint:boundaries": "node scripts/check-boundaries.mjs",
    "dev": "concurrently -n relay,shell -c magenta,cyan \"pnpm relay\" \"pnpm --filter @karta/shell dev\"",
    "dev:sandbox": "pnpm --filter @karta/shell dev:sandbox",
    "e2e": "playwright test",
    "conformance": "echo \"conformance: not implemented until WP4/WP8\" && exit 0",
    "relay": "jazz-run sync --port 4201 --in-memory",
    "dev:shell-only": "pnpm --filter @karta/shell dev",
    "typecheck:spikes": "tsc -p docs/spikes/tsconfig.json",
    "test:e2e:prod": "KARTA_PROD=1 playwright test --project=prod"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.12",
    "concurrently": "^10.0.4",
    "jazz-run": "0.20.19",
    "typescript": "^5.5.4",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
