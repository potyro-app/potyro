{
  "name": "potyro",
  "version": "0.0.0",
  "author": "Edgar Zanella Alvarenga",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.5.0",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint:boundaries": "node scripts/check-boundaries.mjs",
    "lint:tokens": "node scripts/check-tokens.mjs",
    "lint:i18n": "node scripts/check-i18n.mjs",
    "lint:docs": "node scripts/check-doc-paths.mjs && node scripts/docs-index.mjs --check && node scripts/check-agent-map.mjs",
    "docs:index": "node scripts/docs-index.mjs",
    "i18n:extract": "pnpm --filter @potyro/i18n exec lingui extract --clean",
    "ci:local": "node scripts/ci-local.mjs",
    "ship": "node scripts/ship.mjs",
    "dev": "concurrently -n relay,shell -c magenta,cyan \"pnpm relay\" \"pnpm --filter @potyro/shell dev\"",
    "dev:sandbox": "pnpm --filter @potyro/shell dev:sandbox",
    "dev:sandbox:quickjs": "pnpm --filter @potyro/shell dev:sandbox:quickjs",
    "e2e": "playwright test",
    "e2e:launcher": "playwright test e2e/launcher",
    "e2e:baselines": "POTYRO_BASELINES=1 playwright test e2e/launcher/baselines-trusted.spec.ts --update-snapshots",
    "conformance": "pnpm --filter @potyro/capabilities exec vitest run test/conformance-web.test.ts && pnpm --filter @potyro/native exec vitest run test/conformance-capacitor.test.ts",
    "relay": "jazz-run sync --port 4201 --in-memory",
    "dev:shell-only": "pnpm --filter @potyro/shell dev",
    "test:e2e:prod": "POTYRO_PROD=1 playwright test --project=prod",
    "test:e2e:firefox": "POTYRO_FIREFOX=1 playwright test --project=trusted-firefox --project=sandbox-firefox",
    "pack:app": "node scripts/pack-app.mjs",
    "new:app": "node scripts/new-app.mjs",
    "check:app": "pnpm --filter @potyro/generator check:app --",
    "gallery:build": "node gallery/src/build.mjs",
    "site:build": "node site/build.mjs",
    "gallery:publish": "node gallery/src/publish.mjs",
    "i18n:app": "pnpm --filter @potyro/generator i18n:app"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.12",
    "concurrently": "^10.0.4",
    "jazz-run": "0.20.19",
    "typescript": "^5.5.4",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "patchedDependencies": {
      "@sqlite.org/sqlite-wasm@3.53.0-build1": "patches/@sqlite.org__sqlite-wasm@3.53.0-build1.patch"
    }
  }
}
