msgstr "Segui in diretta"

#: msg
msgid "Stop"
msgstr "Ferma"

#: msg
msgid "Add"
msgstr "Aggiungi"

#: ctx.t
msgid "Play the demo again"
msgstr "Rivedi la demo"

#: ctx.t
msgid "A made-up market, played here. Nothing is sent."
msgstr "Un mercato inventato, riprodotto qui. Non viene inviato nulla."

#: ctx.t
msgid "Clear the demo"
msgstr "Cancella la demo"

#: ctx.t
msgid "No price yet"
msgstr "Ancora nessun prezzo"

#: ctx.t
msgid "since the day before"
msgstr "dal giorno prima"

#: ctx.t
