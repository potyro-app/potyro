msgid "at {p}"
msgstr "a {p}"

#: ctx.t
msgid "Already live."
msgstr "Già in diretta."

#: ctx.t
msgid "Currencies updated: the ECB's rates, which change once a working day."
msgstr "Valute aggiornate: i tassi della BCE, che cambiano una volta per giorno lavorativo."

#: ctx.t
msgid "Couldn't fetch the currencies right now."
msgstr "Non è stato possibile scaricare le valute ora."

#: ctx.t
msgid "Add to the watchlist"
msgstr "Aggiungi alla lista"

#: ctx.t
msgid "Take {code} off the watchlist?"
msgstr "Togliere {code} dalla lista?"

#: ctx.t
msgid "Now {price}. Leave empty for none."
msgstr "Ora {price}. Lascia vuoto per nessuno."

#: ctx.t
msgid "Alert for {code}"
msgstr "Avviso per {code}"

#: ctx.t
msgid "Tell me when it goes above"
msgstr "Avvisami quando supera"

#: ctx.t
msgid "Tell me when it drops below"
msgstr "Avvisami quando scende sotto"

#: ctx.t
msgid "Save"
msgstr "Salva"

#: ctx.t
msgid "Alert set. It rings once, while the app is open."
msgstr "Avviso impostato. Suona una volta, con l'app aperta."

#: ctx.t
msgid "No alert for {code}."
msgstr "Nessun avviso per {code}."

#: ctx.t
msgid "Demo prices cleared."
msgstr "Prezzi della demo cancellati."

#: msg
msgid "Not live"
msgstr "Non in diretta"

#: msg
msgid "Connecting…"
msgstr "Connessione…"

#: msg
msgid "Live"
msgstr "In diretta"

#: msg
msgid "Connection lost — trying again"
msgstr "Connessione persa — riprovo"

#: msg
msgid "Paused while you were away"
msgstr "In pausa mentre eri via"

#: msg
msgid "You're offline"
msgstr "Sei offline"

#: msg
msgid "Can't reach the prices right now"
msgstr "Non riesco a ottenere i prezzi ora"

#: msg
msgid "Not allowed to connect"
msgstr "Connessione non consentita"

#: msg
msgid "This copy can't reach Coinbase"
msgstr "Questa copia non può raggiungere Coinbase"

#: msg
msgid "Demo — made-up prices"
msgstr "Demo — prezzi inventati"

#: msg
msgid "Demo finished"
msgstr "Demo finita"

#: msg
msgid "Currencies: the ECB's reference rates, which change once a working day — fetched every 30 minutes."
msgstr "Valute: i tassi di riferimento della BCE, che cambiano una volta per giorno lavorativo — scaricati ogni 30 minuti."

#: msg
msgid "Tap “Watch live” for live prices — or “Demo” to see how it looks. Add symbols with “Add”."
msgstr "Tocca “Segui in diretta” per i prezzi in diretta, oppure “Demo” per vedere come appare. Aggiungi simboli con “Aggiungi”."

#: msg
msgid "Opening the connection to Coinbase."
msgstr "Apro la connessione con Coinbase."

#: msg
msgid "Crypto: every trade on Coinbase, shown at most every 3 seconds. "
msgstr "Cripto: ogni scambio su Coinbase, mostrato al massimo ogni 3 secondi. "

#: msg
msgid "It picks up again by itself."
msgstr "Riprende da solo."

#: msg
msgid "It carries on as soon as you are back."
msgstr "Riprende appena torni."

#: msg
msgid "It connects again when you are back online. The last prices stay here."
msgstr "Si ricollega quando torni online. Gli ultimi prezzi restano qui."

#: msg
msgid "Trying again, a little less often each time. The demo works without it."
msgstr "Riprovo, ogni volta un po' meno spesso. La demo funziona anche senza."

#: msg
msgid "Tap “Watch live” to be asked again."
msgstr "Tocca “Segui in diretta” per ricevere di nuovo la domanda."

#: msg
msgid "The demo still works."
msgstr "La demo funziona comunque."

#: msg
msgid "A made-up market on this device, ticking several times a second. Nothing is sent anywhere."
msgstr "Un mercato inventato su questo dispositivo, più volte al secondo. Non viene inviato nulla."

#: msg
msgid "“Watch live” shows real prices; “Clear the demo” removes the made-up ones."
msgstr "“Segui in diretta” mostra i prezzi veri; “Cancella la demo” toglie quelli inventati."

