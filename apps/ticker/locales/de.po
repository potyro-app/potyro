msgid "Watch live"
msgstr "Live verfolgen"

#: msg
msgid "Stop"
msgstr "Stopp"

#: msg
msgid "Add"
msgstr "Hinzufügen"

#: ctx.t
msgid "Play the demo again"
msgstr "Demo noch einmal"

#: ctx.t
msgid "A made-up market, played here. Nothing is sent."
msgstr "Ein erfundener Markt, hier abgespielt. Nichts wird gesendet."

#: ctx.t
msgid "Clear the demo"
msgstr "Demo löschen"

#: ctx.t
msgid "No price yet"
msgstr "Noch kein Kurs"

#: ctx.t
msgid "since the day before"
msgstr "zum Vortag"

#: ctx.t
msgid "in 24 h"
msgstr "in 24 Std."

