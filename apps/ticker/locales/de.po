msgid "above {p}"
msgstr "über {p}"

#: ctx.t
msgid "below {p}"
msgstr "unter {p}"

#: ctx.t
msgid "at {p}"
msgstr "bei {p}"

#: ctx.t
msgid "Already live."
msgstr "Läuft schon live."

#: ctx.t
msgid "Currencies updated: the ECB's rates, which change once a working day."
msgstr "Währungen aktualisiert: die Kurse der EZB, die sich einmal pro Werktag ändern."

#: ctx.t
msgid "Couldn't fetch the currencies right now."
msgstr "Die Währungen konnten gerade nicht geladen werden."

#: ctx.t
msgid "Add to the watchlist"
msgstr "Zur Liste hinzufügen"

#: ctx.t
msgid "Take {code} off the watchlist?"
msgstr "{code} von der Liste nehmen?"

#: ctx.t
msgid "Now {price}. Leave empty for none."
msgstr "Jetzt {price}. Leer lassen für keinen."

#: ctx.t
msgid "Alert for {code}"
msgstr "Alarm für {code}"

#: ctx.t
msgid "Tell me when it goes above"
msgstr "Sag Bescheid, wenn es über"

#: ctx.t
msgid "Tell me when it drops below"
msgstr "Sag Bescheid, wenn es unter"

#: ctx.t
msgid "Save"
msgstr "Speichern"

#: ctx.t
msgid "Alert set. It rings once, while the app is open."
msgstr "Alarm gesetzt. Er meldet sich einmal, solange die App offen ist."

#: ctx.t
msgid "No alert for {code}."
msgstr "Kein Alarm für {code}."

#: ctx.t
msgid "Demo prices cleared."
msgstr "Demo-Preise gelöscht."

#: msg
msgid "Not live"
msgstr "Nicht live"

#: msg
msgid "Connecting…"
msgstr "Verbinde …"

#: msg
msgid "Live"
msgstr "Live"

#: msg
msgid "Connection lost — trying again"
msgstr "Verbindung weg — neuer Versuch"

#: msg
msgid "Paused while you were away"
msgstr "Pausiert, während du weg warst"

#: msg
msgid "You're offline"
msgstr "Du bist offline"

#: msg
msgid "Can't reach the prices right now"
msgstr "Die Kurse sind gerade nicht erreichbar"

#: msg
msgid "Not allowed to connect"
msgstr "Verbindung nicht erlaubt"

#: msg
msgid "This copy can't reach Coinbase"
msgstr "Diese Kopie kann Coinbase nicht erreichen"

#: msg
msgid "Demo — made-up prices"
msgstr "Demo — erfundene Kurse"

#: msg
msgid "Demo finished"
msgstr "Demo zu Ende"

#: msg
msgid "Currencies: the ECB's reference rates, which change once a working day — fetched every 30 minutes."
msgstr "Währungen: die Referenzkurse der EZB, die sich einmal pro Werktag ändern — alle 30 Minuten abgerufen."

#: msg
msgid "Tap “Watch live” for live prices — or “Demo” to see how it looks. Add symbols with “Add”."
msgstr "Tippe auf „Live verfolgen“ für Live-Kurse — oder auf „Demo“, um es auszuprobieren. Mit „Hinzufügen“ kommen Werte dazu."

#: msg
msgid "Opening the connection to Coinbase."
msgstr "Die Verbindung zu Coinbase wird geöffnet."

#: msg
msgid "Crypto: every trade on Coinbase, shown at most every 3 seconds. "
msgstr "Krypto: jeder Handel auf Coinbase, höchstens alle 3 Sekunden angezeigt. "

#: msg
msgid "It picks up again by itself."
msgstr "Es geht von selbst weiter."

#: msg
msgid "It carries on as soon as you are back."
msgstr "Es geht weiter, sobald du zurück bist."

#: msg
msgid "It connects again when you are back online. The last prices stay here."
msgstr "Es verbindet sich wieder, wenn du online bist. Die letzten Kurse bleiben hier."

#: msg
msgid "Trying again, a little less often each time. The demo works without it."
msgstr "Neue Versuche, jedes Mal etwas seltener. Die Demo geht auch ohne."

#: msg
msgid "Tap “Watch live” to be asked again."
msgstr "Tippe auf „Live verfolgen“, um noch einmal gefragt zu werden."

#: msg
msgid "The demo still works."
msgstr "Die Demo funktioniert trotzdem."

#: msg
msgid "A made-up market on this device, ticking several times a second. Nothing is sent anywhere."
msgstr "Ein erfundener Markt auf diesem Gerät, mehrmals pro Sekunde. Nichts wird gesendet."

#: msg
msgid "“Watch live” shows real prices; “Clear the demo” removes the made-up ones."
msgstr "„Live verfolgen“ zeigt echte Kurse; „Demo löschen“ entfernt die erfundenen."

