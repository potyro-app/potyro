msgstr "Añadir"

#: ctx.t
msgid "Play the demo again"
msgstr "Ver la demo otra vez"

#: ctx.t
msgid "A made-up market, played here. Nothing is sent."
msgstr "Un mercado inventado, reproducido aquí. No se envía nada."

#: ctx.t
msgid "Clear the demo"
msgstr "Borrar la demo"

#: ctx.t
msgid "No price yet"
msgstr "Aún sin precio"

#: ctx.t
