msgstr "a {p}"

#: ctx.t
msgid "Already live."
msgstr "Ya está en vivo."

#: ctx.t
msgid "Currencies updated: the ECB's rates, which change once a working day."
msgstr "Divisas actualizadas: los tipos del BCE, que cambian una vez por día hábil."

#: ctx.t
msgid "Couldn't fetch the currencies right now."
msgstr "No se pudieron obtener las divisas ahora."

#: ctx.t
msgid "Add to the watchlist"
msgstr "Añadir a la lista"

#: ctx.t
msgid "Take {code} off the watchlist?"
msgstr "¿Quitar {code} de la lista?"

#: ctx.t
msgid "Now {price}. Leave empty for none."
msgstr "Ahora {price}. Déjalo vacío para ninguno."

#: ctx.t
msgid "Alert for {code}"
msgstr "Alerta para {code}"

#: ctx.t
msgid "Tell me when it goes above"
msgstr "Avísame cuando suba de"

#: ctx.t
msgid "Tell me when it drops below"
msgstr "Avísame cuando baje de"

#: ctx.t
msgid "Save"
msgstr "Guardar"

#: ctx.t
msgid "Alert set. It rings once, while the app is open."
msgstr "Alerta creada. Suena una vez, con la app abierta."

#: ctx.t
msgid "No alert for {code}."
msgstr "Sin alerta para {code}."

#: ctx.t
msgid "Demo prices cleared."
msgstr "Precios de la demo borrados."

#: msg
msgid "Not live"
msgstr "Sin conexión en vivo"

#: msg
msgid "Connecting…"
msgstr "Conectando…"

#: msg
msgid "Live"
msgstr "En vivo"

#: msg
msgid "Connection lost — trying again"
msgstr "Conexión perdida — reintentando"

#: msg
msgid "Paused while you were away"
msgstr "En pausa mientras no estabas"

#: msg
msgid "You're offline"
msgstr "Estás sin conexión"

#: msg
msgid "Can't reach the prices right now"
msgstr "No se pueden obtener los precios ahora"

#: msg
msgid "Not allowed to connect"
msgstr "Conexión no permitida"

#: msg
msgid "This copy can't reach Coinbase"
msgstr "Esta copia no puede contactar con Coinbase"

#: msg
msgid "Demo — made-up prices"
msgstr "Demo — precios inventados"

#: msg
msgid "Demo finished"
msgstr "Demo terminada"

#: msg
msgid "Currencies: the ECB's reference rates, which change once a working day — fetched every 30 minutes."
msgstr "Divisas: los tipos de referencia del BCE, que cambian una vez por día hábil; se consultan cada 30 minutos."

#: msg
msgid "Tap “Watch live” for live prices — or “Demo” to see how it looks. Add symbols with “Add”."
msgstr "Toca «Ver en vivo» para precios en directo, o «Demo» para ver cómo queda. Añade valores con «Añadir»."

#: msg
msgid "Opening the connection to Coinbase."
msgstr "Abriendo la conexión con Coinbase."

#: msg
msgid "Crypto: every trade on Coinbase, shown at most every 3 seconds. "
msgstr "Cripto: cada operación en Coinbase, mostrada como mucho cada 3 segundos. "

#: msg
msgid "It picks up again by itself."
msgstr "Se reanuda solo."

#: msg
msgid "It carries on as soon as you are back."
msgstr "Sigue en cuanto vuelvas."

#: msg
msgid "It connects again when you are back online. The last prices stay here."
msgstr "Volverá a conectarse cuando tengas conexión. Los últimos precios se quedan aquí."

#: msg
msgid "Trying again, a little less often each time. The demo works without it."
msgstr "Reintentando, cada vez con más pausa. La demo funciona sin ello."

#: msg
msgid "Tap “Watch live” to be asked again."
msgstr "Toca «Ver en vivo» para que se te pregunte otra vez."

#: msg
msgid "The demo still works."
msgstr "La demo sigue funcionando."

#: msg
msgid "A made-up market on this device, ticking several times a second. Nothing is sent anywhere."
msgstr "Un mercado inventado en este dispositivo, varias veces por segundo. No se envía nada."

#: msg
msgid "“Watch live” shows real prices; “Clear the demo” removes the made-up ones."
msgstr "«Ver en vivo» muestra precios reales; «Borrar la demo» quita los inventados."

