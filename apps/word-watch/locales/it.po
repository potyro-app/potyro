#: pages.0.title
#: msg
msgid "Live"
msgstr "Diretta"

#: pages.1.title
msgid "Per minute"
msgstr "Al minuto"

#: pages.1.layout.items.0.view.title
msgid "Right now"
msgstr "Adesso"

#: pages.1.layout.items.0.view.emptyText
msgid "No mentions counted yet."
msgstr "Ancora nessuna menzione contata."

#: pages.1.layout.items.1.view.title
msgid "Mentions per minute"
msgstr "Menzioni al minuto"

#: pages.1.layout.items.1.view.subtitle
msgid "All your words, last 30 minutes"
msgstr "Tutte le tue parole, ultimi 30 minuti"

#: pages.1.layout.items.1.view.emptyText
msgid "The bars fill in minute by minute once you watch live."
msgstr "Le barre si riempiono minuto per minuto quando segui in diretta."

#: pages.2.title
msgid "Words"
msgstr "Parole"

#: pages.2.actions.0.label
msgid "Add a word"
msgstr "Aggiungi parola"

#: pages.2.view.emptyText
msgid "Tap “Add a word” — “coffee”, “#rain”, a team, a town. Posts that mention any of them are kept; everything else streams past."
msgstr "Tocca “Aggiungi parola”: “caffè”, “#pioggia”, una squadra, una città. Restano i post che ne citano una; il resto scorre via."

#: msg
msgid "Watch live"
msgstr "Segui in diretta"

#: msg
msgid "Stop"
msgstr "Ferma"

#: ctx.t
msgid "Play the demo again"
msgstr "Rivedi la demo"

#: ctx.t
msgid "Invented posts, played here. Nothing is sent."
msgstr "Post inventati, riprodotti qui. Non viene inviato nulla."

#: ctx.t
msgid "Clear the demo"
msgstr "Cancella la demo"

#: ctx.t
msgid "{n, plural, one {# match} other {# matches}}"
msgstr "{n, plural, one {# menzione} other {# menzioni}}"

#: msg
msgid "Posts that mention your words land here as they are written. Add words under Words, then “Watch live” — or try “Demo”."
msgstr "I post che citano le tue parole arrivano qui appena vengono scritti. Aggiungi parole in Parole, poi “Segui in diretta”, oppure prova la “Demo”."

#: ctx.t
msgid "{n} at {time}"
msgstr "{n} alle {time}"

#: ctx.t
msgid "{n, plural, one {# mention} other {# mentions}}"
msgstr "{n, plural, one {# menzione} other {# menzioni}}"

#: ctx.t
msgid "paused"
msgstr "in pausa"

#: ctx.t
msgid "seen {ago}"
msgstr "vista {ago}"

#: msg
msgid "Add a word to watch first, under Words."
msgstr "Prima aggiungi una parola da seguire, in Parole."

#: ctx.t
msgid "Already live."
msgstr "Già in diretta."

#: ctx.t
msgid "{n, plural, one {# sample post removed.} other {# sample posts removed.}}"
msgstr "{n, plural, one {# post di esempio cancellato.} other {# post di esempio cancellati.}}"

#: ctx.t
msgid "A word or a phrase to watch"
msgstr "Una parola o frase da seguire"

#: ctx.t
msgid "Already watching “{word}”."
msgstr "Stai già seguendo “{word}”."

#: ctx.t
msgid "Stop watching “{word}”?"
msgstr "Smettere di seguire “{word}”?"

#: msg
msgid "Not live"
msgstr "Non in diretta"

#: msg
msgid "Connecting…"
msgstr "Connessione…"

#: msg
msgid "Connection lost — trying again"
msgstr "Connessione persa — riprovo"

#: msg
msgid "Paused while you were away"
msgstr "In pausa mentre eri via"

#: msg
msgid "You're offline"
msgstr "Sei offline"

#: msg
msgid "Can't reach Bluesky right now"
msgstr "Bluesky non è raggiungibile ora"

#: msg
msgid "Not allowed to connect"
msgstr "Connessione non consentita"

#: msg
msgid "This copy can't reach Bluesky"
msgstr "Questa copia non può raggiungere Bluesky"

#: msg
msgid "Demo — made-up posts"
msgstr "Demo — post inventati"

#: msg
msgid "Demo finished"
msgstr "Demo finita"

#: msg
msgid "Add a few words under Words, then tap “Watch live” — or “Demo” to see how it looks."
msgstr "Aggiungi qualche parola in Parole e tocca “Segui in diretta”, oppure “Demo” per vedere come appare."

#: msg
msgid "Opening the connection to Bluesky."
msgstr "Apro la connessione con Bluesky."

#: msg
msgid "Every new public post on Bluesky passes by; the ones with your words stay."
msgstr "Passano tutti i nuovi post pubblici di Bluesky; restano quelli con le tue parole."

#: msg
msgid "It picks up again by itself."
msgstr "Riprende da solo."

#: msg
msgid "It carries on as soon as you are back. Posts from while you were away are not caught up."
msgstr "Riprende appena torni. I post di quando eri via non vengono recuperati."

#: msg
msgid "It connects again when you are back online."
msgstr "Si ricollega quando torni online."

#: msg
msgid "Trying again, a little less often each time. The demo works without it."
msgstr "Riprovo, ogni volta un po' meno spesso. La demo funziona anche senza."

#: msg
msgid "Tap “Watch live” to be asked again."
msgstr "Tocca “Segui in diretta” per ricevere di nuovo la domanda."

#: msg
msgid "The demo still works."
msgstr "La demo funziona comunque."

#: msg
msgid "Invented posts, played on this device. Nothing is sent anywhere."
msgstr "Post inventati, riprodotti su questo dispositivo. Non viene inviato nulla."

#: msg
msgid "“Watch live” follows the real Bluesky; “Clear the demo” removes the sample posts."
msgstr "“Segui in diretta” mostra il vero Bluesky; “Cancella la demo” toglie i post di esempio."

#: ctx.t
msgid "just now"
msgstr "proprio ora"

