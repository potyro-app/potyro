#: pages.0.title
#: msg
msgid "Live"
msgstr "En vivo"

#: pages.1.title
msgid "Per minute"
msgstr "Por minuto"

#: pages.1.layout.items.0.view.title
msgid "Right now"
msgstr "Ahora mismo"

#: pages.1.layout.items.0.view.emptyText
msgid "No mentions counted yet."
msgstr "Aún no hay menciones contadas."

#: pages.1.layout.items.1.view.title
msgid "Mentions per minute"
msgstr "Menciones por minuto"

#: pages.1.layout.items.1.view.subtitle
msgid "All your words, last 30 minutes"
msgstr "Todas tus palabras, últimos 30 minutos"

#: pages.1.layout.items.1.view.emptyText
msgid "The bars fill in minute by minute once you watch live."
msgstr "Las barras se llenan minuto a minuto cuando sigues en vivo."

#: pages.2.title
msgid "Words"
msgstr "Palabras"

#: pages.2.actions.0.label
msgid "Add a word"
msgstr "Añadir palabra"

#: pages.2.view.emptyText
msgid "Tap “Add a word” — “coffee”, “#rain”, a team, a town. Posts that mention any of them are kept; everything else streams past."
msgstr "Toca «Añadir palabra»: «café», «#lluvia», un equipo, una ciudad. Se quedan las publicaciones que mencionan alguna; lo demás pasa de largo."

#: msg
msgid "Watch live"
msgstr "Ver en vivo"

#: msg
msgid "Stop"
msgstr "Parar"

#: ctx.t
msgid "Play the demo again"
msgstr "Ver la demo otra vez"

#: ctx.t
msgid "Invented posts, played here. Nothing is sent."
msgstr "Publicaciones inventadas, reproducidas aquí. No se envía nada."

#: ctx.t
msgid "Clear the demo"
msgstr "Borrar la demo"

#: ctx.t
msgid "{n, plural, one {# match} other {# matches}}"
msgstr "{n, plural, one {# mención} other {# menciones}}"

#: msg
msgid "Posts that mention your words land here as they are written. Add words under Words, then “Watch live” — or try “Demo”."
msgstr "Las publicaciones que mencionan tus palabras llegan aquí en cuanto se escriben. Añade palabras en Palabras y toca «Ver en vivo», o prueba la «Demo»."

#: ctx.t
msgid "{n} at {time}"
msgstr "{n} a las {time}"

#: ctx.t
msgid "{n, plural, one {# mention} other {# mentions}}"
msgstr "{n, plural, one {# mención} other {# menciones}}"

#: ctx.t
msgid "paused"
msgstr "en pausa"

#: ctx.t
msgid "seen {ago}"
msgstr "vista {ago}"

#: msg
msgid "Add a word to watch first, under Words."
msgstr "Primero añade una palabra que seguir, en Palabras."

#: ctx.t
msgid "Already live."
msgstr "Ya está en vivo."

#: ctx.t
msgid "{n, plural, one {# sample post removed.} other {# sample posts removed.}}"
msgstr "{n, plural, one {# publicación de ejemplo borrada.} other {# publicaciones de ejemplo borradas.}}"

#: ctx.t
msgid "A word or a phrase to watch"
msgstr "Una palabra o frase que seguir"

#: ctx.t
msgid "Already watching “{word}”."
msgstr "Ya sigues «{word}»."

#: ctx.t
msgid "Stop watching “{word}”?"
msgstr "¿Dejar de seguir «{word}»?"

#: msg
msgid "Not live"
msgstr "Sin conexión en vivo"

#: msg
msgid "Connecting…"
msgstr "Conectando…"

#: msg
msgid "Connection lost — trying again"
msgstr "Conexión perdida — reintentando"

#: msg
msgid "Paused while you were away"
msgstr "En pausa mientras no estabas"

#: msg
msgid "You're offline"
msgstr "Estás sin conexión"

#: msg
msgid "Can't reach Bluesky right now"
msgstr "No se puede contactar con Bluesky ahora"

#: msg
msgid "Not allowed to connect"
msgstr "Conexión no permitida"

#: msg
msgid "This copy can't reach Bluesky"
msgstr "Esta copia no puede contactar con Bluesky"

#: msg
msgid "Demo — made-up posts"
msgstr "Demo — publicaciones inventadas"

#: msg
msgid "Demo finished"
msgstr "Demo terminada"

#: msg
msgid "Add a few words under Words, then tap “Watch live” — or “Demo” to see how it looks."
msgstr "Añade unas palabras en Palabras y toca «Ver en vivo», o «Demo» para ver cómo queda."

#: msg
msgid "Opening the connection to Bluesky."
msgstr "Abriendo la conexión con Bluesky."

#: msg
msgid "Every new public post on Bluesky passes by; the ones with your words stay."
msgstr "Pasan todas las publicaciones públicas nuevas de Bluesky; se quedan las que tienen tus palabras."

#: msg
msgid "It picks up again by itself."
msgstr "Se reanuda solo."

#: msg
msgid "It carries on as soon as you are back. Posts from while you were away are not caught up."
msgstr "Sigue en cuanto vuelvas. Las publicaciones de mientras no estabas no se recuperan."

#: msg
msgid "It connects again when you are back online."
msgstr "Volverá a conectarse cuando tengas conexión."

#: msg
msgid "Trying again, a little less often each time. The demo works without it."
msgstr "Reintentando, cada vez con más pausa. La demo funciona sin él."

#: msg
msgid "Tap “Watch live” to be asked again."
msgstr "Toca «Ver en vivo» para que se te pregunte otra vez."

#: msg
msgid "The demo still works."
msgstr "La demo sigue funcionando."

#: msg
msgid "Invented posts, played on this device. Nothing is sent anywhere."
msgstr "Publicaciones inventadas, reproducidas en este dispositivo. No se envía nada."

#: msg
msgid "“Watch live” follows the real Bluesky; “Clear the demo” removes the sample posts."
msgstr "«Ver en vivo» sigue el Bluesky real; «Borrar la demo» quita las publicaciones de ejemplo."

#: ctx.t
msgid "just now"
msgstr "ahora mismo"

