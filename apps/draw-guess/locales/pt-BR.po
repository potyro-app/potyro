msgstr "Segundos para desenhar"

#: msg
msgid "Start the game"
msgstr "Começar o jogo"

#: msg
msgid "It takes two. Invite someone!"
msgstr "São precisos dois. Convide alguém!"

#: msg
msgid "{name} starts the game when everyone's in."
msgstr "{name} começa o jogo quando todos chegarem."

#: msg
msgid "Leave"
msgstr "Sair"

#: msg
msgid "Leave the game?"
msgstr "Sair do jogo?"

#: msg
msgid "The others play on without you."
msgstr "Os outros continuam jogando sem você."

#: msg
msgid "Stay"
msgstr "Ficar"

#: msg
msgid "Round {n} of {total}"
msgstr "Rodada {n} de {total}"

#: msg
msgid "Pick a word to draw"
msgstr "Escolha uma palavra para desenhar"

#: msg
msgid "Only you can see these. If you wait, the first one is chosen for you."
msgstr "Só você vê estas. Se esperar, a primeira é escolhida por você."

#: msg
msgid "Your turn to draw!"
msgstr "Sua vez de desenhar!"

#: msg
msgid "{name} is picking a word…"
msgstr "{name} está escolhendo uma palavra…"

#: msg
msgid "Draw"
msgstr "Desenhe"

#: msg
msgid "{name} is drawing"
msgstr "{name} está desenhando"

#: msg
msgid "Type your guess…"
msgstr "Digite seu palpite…"

#: msg
msgid "Guess"
msgstr "Chutar"

#: msg
msgid "The others are guessing. Keep drawing!"
msgstr "Os outros estão adivinhando. Continue desenhando!"

#: msg
msgid "“{text}” is so close!"
msgstr "“{text}” está quase!"

#: msg
msgid "{name} guessed it!"
msgstr "{name} acertou!"

#: msg
msgid "You guessed it!"
msgstr "Você acertou!"

#: msg
msgid "{name} joined"
msgstr "{name} entrou"

#: msg
msgid "{name} left"
msgstr "{name} saiu"

#: msg
msgid "The word was"
msgstr "A palavra era"

#: msg
msgid "Time's up!"
msgstr "Acabou o tempo!"

#: msg
msgid "{name} left, so on to the next turn."
msgstr "{name} saiu, então vamos para a próxima vez."

#: msg
msgid "{name} didn't pick a word in time."
msgstr "{name} não escolheu uma palavra a tempo."

#: msg
msgid "Next up: {name}"
msgstr "Agora é a vez de {name}"

#: msg
msgid "Game over!"
msgstr "Fim de jogo!"

#: msg
msgid "{name} wins!"
msgstr "{name} venceu!"

#: msg
msgid "You win!"
msgstr "Você venceu!"

#: msg
msgid "It's a tie!"
msgstr "Deu empate!"

#: msg
msgid "{n} pts"
msgstr "{n} pts"

#: msg
msgid "Play again"
msgstr "Jogar de novo"

#: msg
msgid "{name} can start another game."
msgstr "{name} pode começar outro jogo."

