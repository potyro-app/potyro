msgstr "Gomma"

#: msg
msgid "Thin"
msgstr "Sottile"

#: msg
msgid "Medium"
msgstr "Medio"

#: msg
msgid "Thick"
msgstr "Spesso"

#: msg
msgid "Undo"
msgstr "Annulla"

#: msg
msgid "Clear"
msgstr "Pulisci"

#: msg
msgid "Sounds on"
msgstr "Suoni attivi"

#: msg
msgid "Sounds off"
msgstr "Suoni disattivati"

