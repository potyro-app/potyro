msgstr "{h} · nastrój {m} {face}"

#: ctx.t
msgid "How did you sleep?"
msgstr "Jak ci się spało?"

#: ctx.t
msgid "Save"
msgstr "Zapisz"

#: ctx.t
msgid "Logged {h} · {face}"
msgstr "Zapisano: {h} · {face}"

#: ctx.t
msgid "🌙  Log last night"
msgstr "🌙  Zapisz ostatnią noc"

#: ctx.t
msgid "Sleep"
msgstr "Sen"

#: ctx.t
msgid "Hours slept and mood for each day, up to the last 30"
msgstr "Godziny snu i nastrój z każdego dnia, do 30 ostatnich"

#: ctx.t
msgid "Night by night"
msgstr "Noc po nocy"

#: ctx.t
msgid "Sleep on the left, mood on the right"
msgstr "Sen po lewej, nastrój po prawej"

#: ctx.t
msgid "Each night as a dot: hours slept across, mood up, coloured by what the day had"
msgstr "Każda noc to kropka: godziny snu w poziomie, nastrój w pionie, kolor według tego, co przyniósł dzień"

#: ctx.t
msgid "Show nights by tag"
msgstr "Pokaż noce według tagu"

#: ctx.t
msgid "Does a long night lift the day?"
msgstr "Czy długa noc poprawia dzień?"

#: ctx.t
msgid "Every dot is a night, coloured by what the day had"
msgstr "Każda kropka to noc, w kolorze tego, co przyniósł dzień"

#: ctx.t
msgid "The dashed line is the trend: the steeper it climbs, the more sleep shows in your mood."
msgstr "Linia przerywana to trend: im bardziej stromo rośnie, tym bardziej sen widać w twoim nastroju."

#: ctx.t
msgid "{n, plural, one {# check-in} other {# check-ins}} · {range}"
msgstr "{n, plural, one {# wpis} few {# wpisy} many {# wpisów} other {# wpisu}} · {range}"

#: ctx.t
msgid "Your nights"
msgstr "Twoje noce"

#: ctx.t
msgid "Average sleep"
msgstr "Średni sen"

#: ctx.t
msgid "Average mood"
msgstr "Średni nastrój"

#: ctx.t
msgid "Nights ≥ {h}h"
msgstr "Noce ≥ {h} godz."

#: ctx.t
msgid "Last night"
msgstr "Ostatnia noc"

#: ctx.t
msgid "Week: {avg} a night"
msgstr "Tydzień: {avg} na noc"

#: ctx.t
msgid "{h} slept"
msgstr "{h} snu"

#: ctx.t
msgid "nothing tagged"
msgstr "bez tagu"

#: ctx.t
msgid "rough"
msgstr "fatalnie"

#: ctx.t
