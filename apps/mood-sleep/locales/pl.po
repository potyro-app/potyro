msgid "{h}h"
msgstr "{h} godz."

#: ctx.t
msgid "{n, plural, one {# hour} other {# hours}}"
msgstr "{n, plural, one {# godzina} few {# godziny} many {# godzin} other {# godziny}}"

#: ctx.t
msgid "Long nights or short, your mood stays close to {m}. Sleep is not what moves it."
msgstr "Długie noce czy krótkie — twój nastrój trzyma się około {m}. To nie sen go zmienia."

#: ctx.t
msgid "On nights of {long} or more your mood averages {a}. Under {short}, it's {b}."
msgstr "Po nocach, w które śpisz {long} lub dłużej, twój nastrój wynosi średnio {a}. Poniżej {short} — {b}."

#: ctx.t
msgid "On days you exercise"
msgstr "W dni z ćwiczeniami"

#: ctx.t
msgid "On coffee days"
msgstr "W dni z kawą"

#: ctx.t
msgid "After a drink"
msgstr "Po alkoholu"

#: ctx.t
msgid "After late screens"
msgstr "Po wieczorze przed ekranem"

#: ctx.t
msgid "On days with a nap"
msgstr "W dni z drzemką"

#: ctx.t
msgid "On stressful days"
msgstr "W stresujące dni"

#: ctx.t
msgid "On days tagged “{tag}”"
msgstr "W dni z tagiem „{tag}”"

#: msg
msgid "{lead} your mood averages {a}, against {b} without."
msgstr "{lead} twój nastrój wynosi średnio {a}, a w pozostałe dni {b}."

#: msg
msgid "{lead} you sleep {a} on average, against {b} without."
msgstr "{lead} śpisz średnio {a}, a w pozostałe dni {b}."

#: ctx.t
msgid "{have, plural, one {# check-in} other {# check-ins}} so far. A few more nights — about {need} — and a pattern starts to show."
msgstr "Na razie {have, plural, one {# wpis} few {# wpisy} many {# wpisów} other {# wpisu}}. Jeszcze kilka nocy — około {need} — i zacznie się rysować wzór."

#: ctx.t
msgid "Log how you slept tonight. After a week or so, this is where the pattern shows up."
msgstr "Zapisz, jak ci się spało tej nocy. Po mniej więcej tygodniu tutaj pojawi się wzór."

