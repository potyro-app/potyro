msgstr "Último: {place}"

#: ctx.t
msgid "Alerts near you"
msgstr "Alertas perto de você"

#: ctx.t
msgid "Change them under Near me."
msgstr "Mude em Perto de mim."

#: ctx.t
msgid "Off"
msgstr "Desligados"

#: msg
msgid "No earthquakes here yet. Tap “Watch live” to follow EMSC's feed — the last day is filled in first — or “Demo” to see how it looks without connecting."
msgstr "Ainda não há terremotos aqui. Toque em “Ver ao vivo” para acompanhar o feed do EMSC — o último dia vem primeiro — ou em “Demo” para ver como fica sem se conectar."

#: ctx.t
msgid "No earthquakes on this device that close. Widen “Within km”, or set an alert for the next one."
msgstr "Nenhum terremoto tão perto neste aparelho. Aumente o “Raio em km” ou crie um alerta para o próximo."

#: ctx.t
msgid "Tap “Where I am” to see the earthquakes near you, nearest first in time. “Alerts…” tells you about a strong one close by while the app is open."
msgstr "Toque em “Onde estou” para ver os terremotos perto de você. “Alertas…” avisa de um forte por perto enquanto o app está aberto."

#: ctx.t
msgid "Already live."
msgstr "Já está ao vivo."

#: ctx.t
msgid "{n, plural, one {# sample quake removed.} other {# sample quakes removed.}}"
msgstr "{n, plural, one {# terremoto de exemplo removido.} other {# terremotos de exemplo removidos.}}"

#: ctx.t
msgid "Tell me about strong earthquakes near me"
msgstr "Avise-me de terremotos fortes perto de mim"

#: ctx.t
msgid "Within"
msgstr "Num raio de"

#: ctx.t
msgid "Save"
msgstr "Salvar"

#: ctx.t
msgid "Alerts need to know where you are; your location wasn't available."
msgstr "Os alertas precisam saber onde você está; sua localização não estava disponível."

#: ctx.t
msgid "Alerts on: {mag} and up within {km} km, while the app is open."
msgstr "Alertas ligados: {mag} ou mais num raio de {km} km, com o app aberto."

#: ctx.t
msgid "Alerts off."
msgstr "Alertas desligados."

#: msg
msgid "Minor"
msgstr "Fraco"

#: msg
msgid "Light"
msgstr "Leve"

#: msg
msgid "Moderate"
msgstr "Moderado"

#: msg
msgid "Strong"
msgstr "Forte"

#: msg
msgid "Major"
msgstr "Muito forte"

#: msg
msgid "Not live"
msgstr "Fora do ar"

#: msg
msgid "Connecting…"
msgstr "Conectando…"

#: msg
msgid "Live"
msgstr "Ao vivo"

#: msg
msgid "Connection lost — trying again"
msgstr "Conexão perdida — tentando de novo"

#: msg
msgid "Paused while you were away"
msgstr "Pausado enquanto você estava fora"

#: msg
msgid "You're offline"
msgstr "Você está sem internet"

#: msg
msgid "Can't reach EMSC right now"
msgstr "Não foi possível alcançar o EMSC agora"

#: msg
msgid "Not allowed to connect"
msgstr "Conexão não permitida"

#: msg
msgid "This copy can't reach EMSC"
msgstr "Esta cópia não consegue alcançar o EMSC"

#: msg
msgid "Demo — a replay"
msgstr "Demonstração — uma reprise"

#: msg
msgid "Demo finished"
msgstr "Demonstração terminada"

#: msg
msgid "Tap “Watch live” to follow new earthquakes as EMSC reports them — or “Demo” to see how it looks."
msgstr "Toque em “Ver ao vivo” para acompanhar os novos terremotos assim que o EMSC os informa — ou em “Demo” para ver como fica."

#: msg
msgid "Opening the connection to EMSC."
msgstr "Abrindo a conexão com o EMSC."

#: msg
msgid "New earthquakes appear the moment EMSC reports them."
msgstr "Os novos terremotos aparecem assim que o EMSC os informa."

#: msg
msgid "It picks up again by itself."
msgstr "Ele volta sozinho."

#: msg
msgid "It carries on as soon as you are back."
msgstr "Continua assim que você voltar."

#: msg
msgid "It connects again when you are back online. What you already have stays here."
msgstr "Ele se conecta de novo quando a internet voltar. O que você já tem continua aqui."

#: msg
msgid "Trying again, a little less often each time. The demo works without it."
msgstr "Tentando de novo, um pouco mais espaçado a cada vez. A demonstração funciona sem ele."

#: msg
msgid "Tap “Watch live” to be asked again."
msgstr "Toque em “Ver ao vivo” para ser perguntado de novo."

#: msg
msgid "The demo still works."
msgstr "A demonstração continua funcionando."

#: msg
msgid "Real earthquakes from earlier, replayed on this device. Nothing is sent anywhere."
msgstr "Terremotos reais de antes, repetidos neste aparelho. Nada é enviado."

#: msg
msgid "“Watch live” follows the real feed; “Clear the demo” removes the sample quakes."
msgstr "“Ver ao vivo” acompanha o feed real; “Limpar a demo” tira os terremotos de exemplo."

