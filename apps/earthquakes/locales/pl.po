#: msg
msgid "Stop"
msgstr "Zatrzymaj"

#: ctx.t
msgid "Play the demo again"
msgstr "Odtwórz demo jeszcze raz"

#: ctx.t
msgid "Real earthquakes from earlier, replayed here. Nothing is sent."
msgstr "Prawdziwe trzęsienia z przeszłości, odtworzone tutaj. Nic nie jest wysyłane."

#: ctx.t
msgid "Clear the demo"
msgstr "Usuń demo"

#: ctx.t
msgid "{n} new"
msgstr "{n} nowych"

